{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research_top10_stability_policy.schema.json",
  "title": "Research top-10 stability policy",
  "type": "object",
  "required": ["version", "manifest", "entries"],
  "properties": {
    "version": {"const": 1},
    "manifest": {
      "type": "object",
      "required": ["source_hash", "cluster_map_hash", "contract_hash", "git_commit", "seed", "repetitions", "generated_at"]
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dataset", "grain", "metric", "position", "base_cohort", "members", "state", "forward_threshold", "evidence_years", "annual_evidence"],
        "properties": {
          "state": {"enum": ["stable", "left_censored", "right_censored", "structurally_unstable", "not_applicable"]},
          "forward_threshold": {"type": ["integer", "null"], "minimum": 1},
          "members": {"type": "array", "minItems": 1, "uniqueItems": true},
          "annual_evidence": {"type": "array"}
        }
      }
    }
  }
}
